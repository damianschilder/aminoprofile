# Copy to .env and fill in. Both are optional.

# USDA FoodData Central API key (free: https://fdc.nal.usda.gov/api-key-signup).
# Server-only. Without it the server falls back to USDA's heavily rate-limited DEMO_KEY.
NUXT_FOODCENTRAL_API_KEY=

# Cloudflare Web Analytics token. Without it no analytics script is loaded.
NUXT_PUBLIC_CF_BEACON_TOKEN=
